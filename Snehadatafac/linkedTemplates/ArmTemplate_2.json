												"value": "@concat('select LastWatermark from dbo.ETL_Metadata_SY where tablename=''',item().tablename,'''')",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"dataset": {
											"referenceName": "AzureSqlTable7",
											"type": "DatasetReference",
											"parameters": {}
										},
										"firstRowOnly": true
									}
								},
								{
									"name": "Lookup updated at",
									"type": "Lookup",
									"dependsOn": [
										{
											"activity": "lookup lastwatermark",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
